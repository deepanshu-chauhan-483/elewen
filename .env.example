# ─── General ───────────────────────────────────────────────
NODE_ENV=development

# ─── Database (shared by Strapi + API) ─────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=elewen
DATABASE_URL=postgresql://your_db_user:your_db_password@postgres:5432/elewen?schema=api

# ─── Express API ───────────────────────────────────────────
PORT=3000
JWT_SECRET=generate_a_strong_random_secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:5175
ADMIN_PANEL_NO_AUTH=false
ADMIN_ACCESS_USE_LEGACY_FALLBACKS=false
BOOTSTRAP_DEFAULT_ADMIN=false
DEV_ADMIN_EMAIL=admin@elewen.local
DEV_ADMIN_PASSWORD=Admin@12345
DEV_ADMIN_FIRST_NAME=Elewen
DEV_ADMIN_LAST_NAME=Admin
DEV_ADMIN_PHONE=9999999999

# ─── Strapi ────────────────────────────────────────────────
STRAPI_URL=http://strapi:1337
STRAPI_JWT_SECRET=generate_a_strong_random_secret
STRAPI_ADMIN_JWT_SECRET=generate_a_strong_random_secret
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=generate_a_strong_random_salt
STRAPI_TRANSFER_TOKEN_SALT=generate_a_strong_random_salt
PUBLIC_URL=https://yourdomain.com/cms
FRONTEND_URL=https://yourdomain.com
ADMIN_EMAILS=panchalpreet26@gmail.com
ADMIN_USER_IDS=33
ADMIN_ALLOW_ALL_AUTHENTICATED=false

# ─── Frontend (Vite) ───────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_STRAPI_URL=http://localhost:1337
VITE_USE_FALLBACK=false

# Cloudflare R2 + Google OAuth
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your-public-r2-domain.example.com
R2_REGION=auto
R2_FORCE_PATH_STYLE=true

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
