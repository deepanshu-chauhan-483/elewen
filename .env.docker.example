# Copy to .env in project root before: docker compose up --build -d
# cp .env.docker.example .env

NODE_ENV=production

# ─── Database ────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=elewen
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/elewen?schema=api

# ─── Public URLs (nginx + browser + Vite build args) ───────
PUBLIC_SITE_URL=https://elewen.co.in
PUBLIC_API_URL=https://api.elewen.co.in
PUBLIC_STRAPI_URL=https://strapi.elewen.co.in
PUBLIC_ADMIN_URL=https://admin.elewen.co.in

# ─── CORS (http + https for each public origin) ─────────────
CORS_ORIGIN=https://elewen.co.in,https://www.elewen.co.in,https://api.elewen.co.in,https://admin.elewen.co.in,https://strapi.elewen.co.in,http://elewen.co.in,http://www.elewen.co.in,http://api.elewen.co.in,http://admin.elewen.co.in,http://strapi.elewen.co.in,http://localhost:5173,http://localhost:5174,http://localhost:3000

# ─── Let's Encrypt (free SSL) ────────────────────────────────
CERTBOT_EMAIL=admin@elewen.co.in
CERTBOT_CERT_NAME=elewen.co.in
# 1 = use Let's Encrypt staging (test certs)
CERTBOT_STAGING=0
# 1 = dry-run only (init + auto-renew loop); no real certs saved
CERTBOT_DRY_RUN=0
# Auto-renew interval in seconds (default 12h)
CERTBOT_RENEW_INTERVAL=43200

# ─── API ─────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change_me_api_jwt_secret
STRAPI_URL=http://strapi:1337
STRAPI_JWT_SECRET=change_me_strapi_jwt
STRAPI_API_TOKEN=your_strapi_api_token
REDIS_URL=redis://redis:6379

# ─── Strapi ──────────────────────────────────────────────────
STRAPI_JWT_SECRET=change_me_strapi_jwt
STRAPI_ADMIN_JWT_SECRET=change_me_strapi_admin_jwt
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=change_me_api_token_salt
STRAPI_TRANSFER_TOKEN_SALT=change_me_transfer_token_salt
PUBLIC_URL=https://strapi.elewen.co.in
FRONTEND_URL=https://elewen.co.in

# ─── Frontend build-time (also set via compose build args) ───
VITE_API_URL=https://api.elewen.co.in
VITE_STRAPI_URL=https://strapi.elewen.co.in
VITE_USE_FALLBACK=false
VITE_ADMIN_NO_AUTH=false

# ─── Email / payments / storage (fill with real values) ──────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@elewen.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.elewen.co.in/auth/google/callback
