# Copy to .env in project root before: docker compose up --build -d
# cp .env.docker.example .env
#
# CI validates compose using this file as .env. On the VPS, use a real .env with secrets (never commit it).
#
# Sync secrets from:
#   api/.env          → JWT_SECRET, STRAPI_API_TOKEN, Cashfree, SMTP, admin bootstrap
#   strapi/.env       → STRAPI_* keys/salts, R2, Google OAuth
#   frontend/.env     → VITE_* (use PUBLIC_* URLs for production builds)
#   admin-pannel/.env → VITE_API_URL, VITE_ADMIN_NO_AUTH

NODE_ENV=production

# ─── Database (Docker: host postgres, not 127.0.0.1) ─────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=elewen
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/elewen?schema=api

# ─── Public URLs (nginx + browser + Vite build args) ───────
PUBLIC_SITE_URL=https://elewen.co.in
PUBLIC_API_URL=https://api.elewen.co.in
PUBLIC_STRAPI_URL=https://strapi.elewen.co.in
PUBLIC_ADMIN_URL=https://admin.elewen.co.in

# ─── CORS (http + https for each public origin) ─────────────
CORS_ORIGIN=https://elewen.co.in,https://www.elewen.co.in,https://api.elewen.co.in,https://admin.elewen.co.in,https://strapi.elewen.co.in,http://elewen.co.in,http://www.elewen.co.in,http://api.elewen.co.in,http://admin.elewen.co.in,http://strapi.elewen.co.in,http://localhost:5173,http://localhost:5174,http://localhost:3000

# ─── Let's Encrypt (free SSL) ────────────────────────────────
CERTBOT_EMAIL=your-email@elewen.co.in
CERTBOT_CERT_NAME=elewen.co.in
CERTBOT_STAGING=0
CERTBOT_DRY_RUN=0
CERTBOT_RENEW_INTERVAL=43200

# ─── API (api/.env) ──────────────────────────────────────────
PORT=3000
JWT_SECRET=
APP_URL=https://elewen.co.in
STRAPI_URL=http://strapi:1337
STRAPI_JWT_SECRET=
STRAPI_API_TOKEN=
REDIS_URL=redis://redis:6379

# ─── Strapi (strapi/.env — map JWT_SECRET → STRAPI_JWT_SECRET) ─
STRAPI_ADMIN_JWT_SECRET=
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_TRANSFER_TOKEN_SALT=
PUBLIC_URL=https://strapi.elewen.co.in
FRONTEND_URL=https://elewen.co.in
# Admin login rate limit (default in code: 50 / 5 min)
STRAPI_ADMIN_RATELIMIT_ENABLED=true
STRAPI_ADMIN_RATELIMIT_INTERVAL_MIN=5
STRAPI_ADMIN_RATELIMIT_MAX=50

# ─── Frontend / admin (frontend/.env, admin-pannel/.env) ───────
VITE_API_URL=https://api.elewen.co.in
VITE_STRAPI_URL=https://strapi.elewen.co.in
VITE_USE_FALLBACK=false
VITE_ADMIN_NO_AUTH=false

# ─── Email / SMTP ────────────────────────────────────────────
# SMTP_FROM must use a domain verified in Resend (resend.com/domains) — the
# onboarding@resend.dev sandbox address can only send to your own Resend account email.
SMTP_PROVIDER=resend
RESEND_API_KEY=
SMTP_FROM=no-reply@elewen.co.in
SMTP_FROM_NAME=Elewen
SMTP_REPLY_TO=
SUPPORT_EMAIL=info@elewen.co.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Cashfree (api/.env) ─────────────────────────────────────
CASHFREE_APP_ID=TEST11143225d60cb8544ba6fc035d5a52234111
CASHFREE_SECRET_KEY=cfsk_ma_test_8fa974b715b30200dba713f952c2a886_0186fa74
CASHFREE_ENV=sandbox

# ─── Cloudflare R2 (strapi/.env) ─────────────────────────────
# R2 API token needs Object Read & Write on the bucket. Verify: cd strapi && npm run test:r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=elewen-media
R2_PUBLIC_URL=https://pub-b2588c303cf24efabd0c47d36e96b965.r2.dev
R2_REGION=auto
R2_FORCE_PATH_STYLE=true

# ─── Google OAuth (strapi/.env — use production callback URL) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://strapi.elewen.co.in/api/connect/google/callback

# ─── Admin bootstrap (api/.env, optional) ────────────────────
BOOTSTRAP_DEFAULT_ADMIN=false
DEV_ADMIN_EMAIL=admin@elewen.local
DEV_ADMIN_PASSWORD=
ADMIN_ACCESS_USE_LEGACY_FALLBACKS=false

# ─── Content seeds (production: leave false; run one-shot scripts instead) ─
# Production boot only runs a seed when the flag is exactly "true".
# Development runs seeds unless the flag is "false".
SEED_CATERING_ESSENTIALS=false
SEED_CATERING_MENU=false
SEED_DELIVERY_CHARGES=false
SEED_DECOR_PROPOSAL_PACKAGES=false
SEED_DECOR_ANNIVERSARY_PACKAGES=false
SEED_DECOR_BABY_SHOWER_PACKAGES=false
SEED_DECOR_BACHELORETTE_PACKAGES=false
SEED_DECOR_EXCEL_PACKAGES=false
SEED_PRIVACY_POLICY=false
SEED_TERMS_AND_CONDITIONS=false
# Coupon templates (FIRST500, FIRST10, SUMMER500, etc.) — safe to enable; creates inactive coupons for admin to activate.
SEED_COUPON_TEMPLATES=false
# Word-doc event→themes / decor_flow map. Prefer one-shot remote script on prod:
#   node scripts/seed-event-theme-map-remote.mjs
# Leave false on boot unless intentionally seeding.
SEED_EVENT_THEME_MAP=false
# SEED_EVENT_THEME_MAP_ROLLBACK=true
# Set true only for one-shot content sync (does not remove package images):
# SEED_DECOR_REFRESH_EXISTING=true
