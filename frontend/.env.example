# Strapi CMS (Week 1 — content types, packages, testimonials, blogs)
VITE_STRAPI_URL=http://localhost:1337

# Express custom API (Week 3+ — bookings, payments, planner leads)
VITE_API_URL=http://localhost:3000

# Set to "true" to force all hooks to return placeholder/fallback data instead of fetching Strapi.
# Useful for UI development when Strapi is not running.
VITE_USE_FALLBACK=false

# Cloudinary cloud name — used for image optimization via cloudinary.js
# Must match the CLOUDINARY_NAME in root .env and strapi/.env
VITE_CLOUDINARY_NAME=your_cloud_name
