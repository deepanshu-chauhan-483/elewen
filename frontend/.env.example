# Strapi CMS (Week 1 — content types, packages, testimonials, blogs)
VITE_STRAPI_URL=http://localhost:1337

# Google OAuth must use an absolute Strapi URL (not /cms). Defaults to VITE_STRAPI_URL
# when absolute, otherwise VITE_STRAPI_PROXY_TARGET / https://strapi.elewen.co.in
# VITE_GOOGLE_STRAPI_URL=http://localhost:1337

# Optional: test local UI with DigitalOcean Strapi media — copy .env.local.example → .env.local

# Express custom API (Week 3+ — bookings, payments, planner leads)
VITE_API_URL=http://localhost:3000

# Set to "true" to force all hooks to return placeholder/fallback data instead of fetching Strapi.
# Useful for UI development when Strapi is not running.
VITE_USE_FALLBACK=false

# Decor event→theme catalog: "word-doc" (default) uses docs/event with theme.docx baseline + CMS extras.
# Instant rollback: set to "legacy" and rebuild to restore pre-catalog Sets / fallback merge.
# VITE_DECOR_THEME_CATALOG=word-doc
# VITE_DECOR_THEME_CATALOG=legacy

# Cloudinary cloud name — used for image optimization via cloudinary.js
# Must match the CLOUDINARY_NAME in root .env and strapi/.env
VITE_CLOUDINARY_NAME=your_cloud_name
