# Copy this file to frontend/.env.local (gitignored) to test locally with
# live Strapi content + media. Production is unchanged.
#
#   copy .env.local.example .env.local
#   cd frontend && npm run dev
#
# Browser calls http://localhost:5173/cms/api/... → proxied to https://strapi.elewen.co.in
# (no CORS, no production CORS change). Restart `npm run dev` after edits.

VITE_STRAPI_URL=/cms
VITE_STRAPI_PROXY_TARGET=https://strapi.elewen.co.in
# Google OAuth uses the absolute proxy target (never /cms) so cookies stay on Strapi.
# VITE_GOOGLE_STRAPI_URL=https://strapi.elewen.co.in
VITE_API_URL=http://localhost:3000
VITE_USE_FALLBACK=false
VITE_CLOUDINARY_NAME=dqm4rqqdc

# Decor event→theme catalog: "word-doc" (default) | "legacy" for instant rollback
# VITE_DECOR_THEME_CATALOG=word-doc
# VITE_DECOR_THEME_CATALOG=legacy
