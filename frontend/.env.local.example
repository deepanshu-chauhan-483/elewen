# Copy this file to frontend/.env.local (gitignored) to test locally with
# DigitalOcean Strapi content + uploaded media. Production is unchanged.
#
#   copy .env.local.example .env.local
#   cd frontend && npm run dev
#
# Uses Vite /cms proxy → https://strapi.elewen.co.in (no CORS, no DO config change).

VITE_STRAPI_URL=/cms
VITE_STRAPI_PROXY_TARGET=https://strapi.elewen.co.in
VITE_API_URL=http://localhost:3000
VITE_USE_FALLBACK=false
