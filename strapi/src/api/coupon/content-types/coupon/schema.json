{
  "kind": "collectionType",
  "collectionName": "coupons",
  "info": {
    "singularName": "coupon",
    "pluralName": "coupons",
    "displayName": "Coupon"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true
    },
    "discount_type": {
      "type": "enumeration",
      "enum": [
        "percentage",
        "flat"
      ]
    },
    "discount_value": {
      "type": "decimal",
      "required": true
    },
    "max_uses": {
      "type": "integer"
    },
    "used_count": {
      "type": "integer",
      "default": 0
    },
    "valid_from": {
      "type": "date"
    },
    "valid_to": {
      "type": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
