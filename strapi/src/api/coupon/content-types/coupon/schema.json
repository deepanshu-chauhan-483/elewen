{
  "kind": "collectionType",
  "collectionName": "coupons",
  "info": {
    "singularName": "coupon",
    "pluralName": "coupons",
    "displayName": "Coupon"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "coupon_kind": {
      "type": "enumeration",
      "enum": [
        "public",
        "first_order",
        "referral",
        "festive",
        "seasonal",
        "decor_monthly"
      ],
      "default": "public"
    },
    "discount_type": {
      "type": "enumeration",
      "enum": [
        "percentage",
        "flat"
      ]
    },
    "discount_value": {
      "type": "decimal",
      "required": true
    },
    "min_order_value": {
      "type": "decimal",
      "default": 0
    },
    "max_order_value": {
      "type": "decimal"
    },
    "max_discount_amount": {
      "type": "decimal"
    },
    "first_order_only": {
      "type": "boolean",
      "default": false
    },
    "service_filter": {
      "type": "enumeration",
      "enum": [
        "all",
        "decor"
      ],
      "default": "all"
    },
    "terms_customer": {
      "type": "text"
    },
    "admin_notes": {
      "type": "text"
    },
    "validity_days": {
      "type": "integer"
    },
    "is_user_specific": {
      "type": "boolean",
      "default": false
    },
    "is_shareable": {
      "type": "boolean",
      "default": true
    },
    "max_uses": {
      "type": "integer"
    },
    "used_count": {
      "type": "integer",
      "default": 0
    },
    "valid_from": {
      "type": "date"
    },
    "valid_to": {
      "type": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "banner_shared": {
      "type": "boolean",
      "default": false
    }
  }
}
