{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "author_name": {
      "type": "string",
      "required": true
    },
    "event_category": {
      "type": "string"
    },
    "body": {
      "type": "text",
      "required": true
    },
    "star_rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "default": 5
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "author_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "visibility": {
      "type": "boolean",
      "default": true
    }
  }
}
