{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "Package"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "blocks"
    },
    "base_price": {
      "type": "decimal",
      "required": true
    },
    "discount_active": {
      "type": "boolean",
      "default": false
    },
    "discount_type": {
      "type": "enumeration",
      "enum": [
        "percentage",
        "flat"
      ],
      "default": "percentage"
    },
    "discount_value": {
      "type": "decimal",
      "default": 0
    },
    "discount_badge": {
      "type": "string"
    },
    "discount_valid_from": {
      "type": "date"
    },
    "discount_valid_to": {
      "type": "date"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "most_booked_tag": {
      "type": "boolean",
      "default": false
    },
    "internal_notes": {
      "type": "text"
    },
    "visibility": {
      "type": "boolean",
      "default": true
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "text"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "service_categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service-category.service-category",
      "inversedBy": "packages"
    },
    "saved_packages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::saved-package.saved-package",
      "mappedBy": "package"
    },
    "events": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event",
      "mappedBy": "packages"
    },
    "booking_reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::booking-review.booking-review",
      "mappedBy": "package"
    },
    "reusable_addons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::addon.addon",
      "inversedBy": "packages"
    },
    "packages": {
      "type": "dynamiczone",
      "components": [
        "package.decorpackages",
        "package.sheeshapackage",
        "package.bartendingpackage",
        "package.cateringpackage"
      ]
    }
  }
}
