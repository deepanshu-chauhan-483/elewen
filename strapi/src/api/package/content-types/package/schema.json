{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "Package"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "blocks"
    },
    "base_price": {
      "type": "decimal",
      "required": true
    },
    "min_guests": {
      "type": "integer"
    },
    "max_guests": {
      "type": "integer"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "most_booked_tag": {
      "type": "boolean",
      "default": false
    },
    "internal_notes": {
      "type": "text"
    },
    "visibility": {
      "type": "boolean",
      "default": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "budget_level": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::budget-level.budget-level",
      "inversedBy": "packages"
    },
    "service_categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service-category.service-category",
      "inversedBy": "packages"
    },
    "saved_packages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::saved-package.saved-package",
      "mappedBy": "package"
    },
    "events": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event",
      "mappedBy": "packages"
    },
    "elements": {
      "type": "component",
      "component": "package.package-element",
      "repeatable": true
    },
    "addons": {
      "type": "component",
      "component": "package.package-addon",
      "repeatable": true
    },
    "pricing_rules": {
      "type": "component",
      "component": "package.package-pricing-rule",
      "repeatable": true
    }
  }
}
