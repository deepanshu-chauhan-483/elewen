{
  "kind": "collectionType",
  "collectionName": "vendor_documents",
  "info": {
    "singularName": "vendor-document",
    "pluralName": "vendor-documents",
    "displayName": "Vendor Document"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "document_type": {
      "type": "enumeration",
      "enum": [
        "license",
        "insurance",
        "portfolio",
        "id"
      ]
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "vendor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::vendor.vendor",
      "inversedBy": "vendor_documents"
    }
  }
}
