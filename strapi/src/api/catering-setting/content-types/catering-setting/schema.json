      "default": true
    },
    "discount_title": {
      "type": "string",
      "default": "Guest count discounts"
    },
    "discount_note": {
      "type": "text",
      "default": "Per-person discount applied to catering package price based on selected guest count."
    },
    "guest_discount_tiers": {
      "type": "component",
      "repeatable": true,
      "component": "package.catering-guest-discount-tier"
    }
  }
}
