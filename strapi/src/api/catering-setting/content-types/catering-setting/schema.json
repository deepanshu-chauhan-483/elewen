{
  "kind": "singleType",
  "collectionName": "catering_settings",
  "info": {
    "singularName": "catering-setting",
    "pluralName": "catering-settings",
    "displayName": "Catering Settings",
    "description": "Global catering configuration (guest-count discounts, etc.)"
  },
