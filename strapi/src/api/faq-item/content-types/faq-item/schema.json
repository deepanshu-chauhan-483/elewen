{
  "kind": "collectionType",
  "collectionName": "faq_items",
  "info": {
    "singularName": "faq-item",
    "pluralName": "faq-items",
    "displayName": "Faq Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "category": {
      "type": "enumeration",
      "enum": [
        "general",
        "booking",
        "payment",
        "planner",
        "consultation"
      ]
    },
    "question": {
      "type": "text",
      "required": true
    },
    "answer": {
      "type": "text",
      "required": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "integer"
    }
  }
}
