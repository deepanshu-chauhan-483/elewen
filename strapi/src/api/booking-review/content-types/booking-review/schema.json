{
  "kind": "collectionType",
  "collectionName": "booking_reviews",
  "info": {
    "singularName": "booking-review",
    "pluralName": "booking-reviews",
    "displayName": "Booking Review"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "rating": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    "review_text": {
      "type": "text"
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "booking_reviews"
    }
  }
}
