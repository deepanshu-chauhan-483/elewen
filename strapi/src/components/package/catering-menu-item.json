{
  "collectionName": "components_package_catering_menu_items",
  "info": {
    "displayName": "Catering Menu Item",
    "description": "One row in the Menu selection block (e.g. Starters Choose 4, Accompaniments included)"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "details": {
      "type": "text"
    },
    "row_type": {
      "type": "enumeration",
      "enum": ["choose", "included", "info"],
      "default": "choose"
    },
    "choose_hint": {
      "type": "string"
    },
    "category_key": {
      "type": "enumeration",
      "enum": [
        "pre_plated",
        "starters",
        "starters_non_veg",
        "soup",
        "main_course_veg",
        "main_course_non_veg",
        "rotis_and_rice",
        "rice",
        "raita",
        "salad",
        "live_stations",
        "dessert"
      ]
    },
    "category_key_extra": {
      "type": "enumeration",
      "enum": [
        "pre_plated",
        "starters",
        "starters_non_veg",
        "soup",
        "main_course_veg",
        "main_course_non_veg",
        "rotis_and_rice",
        "rice",
        "raita",
        "salad",
        "live_stations",
        "dessert"
      ]
    },
    "min_pick": {
      "type": "integer",
      "default": 0
    },
    "max_pick": {
      "type": "integer",
      "default": 1
    },
    "veg_pick": {
      "type": "integer",
      "default": 0
    },
    "nonveg_pick": {
      "type": "integer",
      "default": 0
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "config": {}
}
