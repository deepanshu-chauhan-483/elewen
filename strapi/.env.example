# ─── Database ──────────────────────────────────────────────
# When running via Docker Compose, DATABASE_HOST should be "postgres" (the service name).
# When running Strapi directly on the host, use "localhost".
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=elewen
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password

# ─── Strapi Keys ───────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=generate_a_strong_random_secret
ADMIN_JWT_SECRET=generate_a_strong_random_secret
# APP_KEYS must be exactly 4 comma-separated random strings
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=generate_a_strong_random_salt
TRANSFER_TOKEN_SALT=generate_a_strong_random_salt

# Admin login rate limit (default Strapi is 5 / 5 min)
STRAPI_ADMIN_RATELIMIT_ENABLED=true
STRAPI_ADMIN_RATELIMIT_INTERVAL_MIN=5
STRAPI_ADMIN_RATELIMIT_MAX=50

# ─── Cloudflare R2 uploads ───────────────────────────────────
# Create an R2 API token with "Object Read & Write" on the bucket (Admin Read only is not enough).
# After changing keys, restart Strapi and run: npm run test:r2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=elewen-media
R2_PUBLIC_URL=https://pub-b2588c303cf24efabd0c47d36e96b965.r2.dev
R2_REGION=auto
R2_FORCE_PATH_STYLE=true

# ─── Email (SMTP) ────────────────────────────────────────────
# Option A — Gmail / Google Workspace (elewen.co.in on Google)
# SMTP_PROVIDER=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=moksha@elewen.co.in
# SMTP_PASS=16_char_app_password_from_google
# SMTP_FROM=moksha@elewen.co.in
#
# Option B — Resend (if Gmail 535 BadCredentials / no app passwords)
# SMTP_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=onboarding@resend.dev
STRAPI_EMAIL_CONFIRMATION=true

# ─── Google OAuth (Continue with Google) ─────────────────────
PUBLIC_URL=http://localhost:1337
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Prod: https://strapi.elewen.co.in/api/connect/google/callback (add BOTH URIs in Google Console)
GOOGLE_REDIRECT_URI=http://localhost:1337/api/connect/google/callback

# ─── General ───────────────────────────────────────────────
NODE_ENV=development
PORT=1337

# ─── Bootstrap seeds (development: run unless =false; production: only if =true) ──
# After Anniversary packages exist, keep this false so CMS edits are not re-seeded on boot.
SEED_DECOR_ANNIVERSARY_PACKAGES=false
# Opt-in only: overwrite existing decor package text/pricing from seed code (never images).
SEED_DECOR_REFRESH_EXISTING=false
