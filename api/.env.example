# ─── Database ──────────────────────────────────────────────
# Used when running prisma/node commands directly on the host (not inside Docker).
# Docker Compose injects DATABASE_URL automatically via root .env.
DATABASE_URL=postgresql://your_db_user:your_db_password@127.0.0.1:5432/elewen?schema=api

# ─── Express API ───────────────────────────────────────────
PORT=3000

# ─── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=generate_a_strong_random_secret

# ─── Strapi ────────────────────────────────────────────────
STRAPI_URL=http://localhost:1337

# ─── Razorpay ──────────────────────────────────────────────
# Test keys start with rzp_test_ | Live keys start with rzp_live_
# Get test keys: Razorpay Dashboard → Settings → API Keys → Generate Test Key (no KYC needed)
# Get live keys: Razorpay Dashboard → switch to Live mode → Settings → API Keys (KYC required)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set a random secret string in Razorpay Dashboard → Settings → Webhooks → webhook secret
# For local dev: use ngrok → ngrok http 3000 → set https://xxxx.ngrok.io/payments/webhook as webhook URL
RAZORPAY_WEBHOOK_SECRET=set_this_in_razorpay_dashboard
