# ─── Database ──────────────────────────────────────────────
# Used when running prisma/node commands directly on the host (not inside Docker).
# Docker Compose injects DATABASE_URL automatically via root .env.
DATABASE_URL=postgresql://your_db_user:your_db_password@127.0.0.1:5432/elewen?schema=api

# ─── Express API ───────────────────────────────────────────
PORT=3000

# ─── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=generate_a_strong_random_secret
# Must match JWT_SECRET in strapi/.env (Strapi signs user JWTs; API verifies them locally).
STRAPI_JWT_SECRET=generate_a_strong_random_secret

# ─── Strapi ────────────────────────────────────────────────
STRAPI_URL=http://localhost:1337
# Optional: public catalog for hybrid local (packages/coupons). Auth still uses STRAPI_URL.
# STRAPI_CONTENT_URL=https://strapi.elewen.co.in

# ─── Email (SMTP) ──────────────────────────────────────────
# Gmail: enable 2FA → myaccount.google.com/apppasswords → create app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your@gmail.com
# Comma-separated admin inboxes for operational emails (refunds, etc.)
ADMIN_EMAILS=ops@elewen.co.in
SUPPORT_EMAIL=info@elewen.co.in
# Used in email CTAs — no trailing slash
APP_URL=https://elewen.in
# Optional override for UPI QR in Mail 3 (2-days-prior). Default: ${APP_URL}/email/upi-payment-qr.jpg
# PAYMENT_QR_IMAGE_URL=https://elewen.in/email/upi-payment-qr.jpg
# Optional Resend instead of SMTP:
# RESEND_API_KEY=
# Feedback gift coupon amount shown in Mail 4
FEEDBACK_COUPON_VALUE=500
# Secure cron for lifecycle emails: POST /jobs/booking-emails
JOBS_SECRET=change-me-to-a-long-random-string
# In-process hourly Mail 3/4 scheduler (set false if using external cron only)
BOOKING_EMAIL_CRON_ENABLED=true
# BOOKING_EMAIL_CRON_INTERVAL_MS=3600000

# ─── Redis ─────────────────────────────────────────────────
# Local: redis://localhost:6379 | Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ─── Cashfree ───────────────────────────────────────────────
# Sandbox app id starts with TEST | Production app id starts with your merchant prefix
CASHFREE_APP_ID=TEST11143225d60cb8544ba6fc035d5a52234111
CASHFREE_SECRET_KEY=cfsk_ma_test_8fa974b715b30200dba713f952c2a886_0186fa74
CASHFREE_ENV=sandbox
# Webhook URL for Cashfree dashboard: https://api.elewen.co.in/payments/webhook
# Subscribe to: PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK, REFUND_STATUS_WEBHOOK
